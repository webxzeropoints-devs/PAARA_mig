PORT=4000
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=
# Optional only for Vercel OIDC auth. A read-write token carries its own store scope.
# BLOB_STORE_ID=
# Public image store (separate from the private database backup store above)
# BLOB_PUBLIC_READ_WRITE_TOKEN=
# BLOB_PUBLIC_STORE_ID=

# Frontend URL (comma-separated list supported)
FRONTEND_URL=http://localhost:5173,https://paara.vercel.app

# Authentication
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_API_KEY=change_this_to_a_long_random_key

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# PayU environment: use production for live credentials, or test for sandbox credentials
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_ENV=production
PAYU_SUCCESS_URL=https://your-backend.example.com/api/payment/payu/success
PAYU_FAILURE_URL=https://your-backend.example.com/api/payment/payu/failure

# Email
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
CATALYST_MEDIA_FOLDER_ID=your_catalyst_filestore_folder_id
