{
  "name": "paara-backend",
  "version": "1.0.0",
  "description": "Backend for Paara jewellery e-commerce site — PostgreSQL + Express + PayU",
  "main": "server.js",
  "scripts": {
    "validate": "node --check api/index.js && node --check server.js",
    "init-db": "node db/init.js",
    "populate-descriptions": "node db/populate-descriptions.js",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.4",
    "twilio": "^6.1.0",
    "zcatalyst-sdk-node": "^3.4.0"
  }
